# 复制为 .env 并填入真实值（.env 已在 .gitignore；本文件可随仓库公开）
# ── 生成链路（任意 OpenAI 兼容端点：自部署 vLLM / 云端 API 均可）──
LLM_API_KEY=EMPTY                     # 无鉴权端点（本地/平台 vLLM）填 EMPTY；云端 API 填真实 key
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=your-model-name
# ── 评测 Judge（可选：异构模型做解读类评分）──
JUDGE_API_KEY=sk-your-key-here
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_MODEL=deepseek-flash

# ── 向量服务端点（可选：backend=remote 时使用；自部署 embedding 服务）──
# EMBED_BASE_URL=http://127.0.0.1:8000
